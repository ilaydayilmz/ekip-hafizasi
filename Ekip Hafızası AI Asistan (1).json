        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"={{ 'RESPOND WITH RAW JSON ONLY. Analyze this message and return JSON with fields: gorev_var, gorev_adi, kisi, deadline, durum, oncelik, kaynak, onemli, kategori. Message: ' + $('Process One by One').item.json.snippet }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"maxOutputTokens\": 1000\n  }\n}",
