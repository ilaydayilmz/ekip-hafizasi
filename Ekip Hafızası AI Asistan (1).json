      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst subject = item.subject || item.Subject || '';\nconst sender = item.from || item.From || item.sender || '';\nconst combined = (subject + sender).toLowerCase();\nlet hash = 0;\nfor (let i = 0; i < combined.length; i++) {\n  const char = combined.charCodeAt(i);\n  hash = ((hash << 5) - hash) + char;\n  hash = hash & hash;\n}\nconst emailHash = Math.abs(hash).toString(16);\nconst rawBody = item.text || item.snippet || item.body || item.Body || '';\nreturn [{\n  json: {\n    ...item,\n    emailHash: emailHash,\n    bodyShort: rawBody.substring(0, 800)\n  }\n}];"
      },
