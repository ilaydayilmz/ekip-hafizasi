        "jsCode": "const profileRows = $input.all();\n\nconst profile = {};\n\nprofileRows.forEach(row => {\n  profile[row.json.Field] = row.json.Value;\n});\n\n// Email verisini de al (ilk item'dan)\nconst emailData = profileRows[0]?.json || {};\n\nreturn [{ json: { userProfile: profile, ...emailData } }];"
