    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst parsedItems = items.map((item) => {\n  let text = item?.json?.candidates[0]?.content?.parts[0]?.text || '';\n  \n  text = text.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  \n  // JSON bulmaya çalış\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[0]);\n      return { json: parsed };\n    } catch(e) {\n      return { json: { classification: 'irrelevant', err: e.message, raw: text } };\n    }\n  }\n  return { json: { classification: 'irrelevant', raw: text } };\n});\nreturn parsedItems;"
      },
