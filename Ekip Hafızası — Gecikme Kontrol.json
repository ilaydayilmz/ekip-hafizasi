    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst tomorrow = new Date(today);\ntomorrow.setDate(tomorrow.getDate() + 1);\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const deadlineStr = item.json.Deadline;\n  if (!deadlineStr || deadlineStr === 'Belirtilmedi') continue;\n  \n  const parts = deadlineStr.split('.');\n  const deadline = new Date(parts[2] + '-' + parts[1] + '-' + parts[0]);\n  deadline.setHours(0, 0, 0, 0);\n  \n  if (deadline <= tomorrow) {\n    item.json.gecikme_durumu = deadline < today ? 'Gecikmis' : 'Yarin bitiyor';\n    results.push(item);\n  }\n}\n\nreturn results;"
      },
