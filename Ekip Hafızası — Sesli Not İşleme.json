        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"inline_data\": {\n            \"mime_type\": \"audio/ogg\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        },\n        {\n          \"text\": \"Bu ses kaydını Türkçe metne çevir ve içinden görevleri, sorumlu kişileri, deadline'ları ve öncelik seviyelerini çıkar. Yanıtını SADECE şu JSON formatında ver, başka hiçbir şey yazma:\\n{\\n  \\\"transkript\\\": \\\"sesin tam metni\\\",\\n  \\\"gorevler\\\": [\\n    {\\n      \\\"gorev\\\": \\\"görev adı\\\",\\n      \\\"kisi\\\": \\\"sorumlu kişi veya Belirsiz\\\",\\n      \\\"oncelik\\\": \\\"Yüksek veya Orta veya Düşük\\\",\\n      \\\"deadline\\\": \\\"GG.AA.YYYY formatında veya Belirsiz\\\",\\n      \\\"durum\\\": \\\"Bekliyor\\\"\\n    }\\n  ]\\n}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Gemini — Ses Analizi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -976,
        384
      ],
      "id": "b9fdaecb-71fd-45e7-abfc-3314601317f6"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\n\n// JSON bloğunu temizle\nconst cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  return [{ json: { hata: 'JSON parse edilemedi', ham: raw } }];\n}\n\nconst gorevler = parsed.gorevler || [];\nconst transkript = parsed.transkript || '';\n\nif (gorevler.length === 0) {\n  return [{ json: { gorev_yok: true, transkript } }];\n}\n\nreturn gorevler.map(g => ({\n  json: {\n    gorev: g.gorev || '',\n    kisi: g.kisi || 'Belirsiz',\n    oncelik: g.oncelik || 'Orta',\n    deadline: g.deadline || 'Belirsiz',\n    durum: 'Bekliyor',\n    kaynak: 'Telegram Sesli Not',\n    transkript,\n    tarih: new Date().toLocaleDateString('tr-TR')\n  }\n}));"
      },
      "name": "Görevleri Ayrıştır",
      "type": "n8n-nodes-base.code",
