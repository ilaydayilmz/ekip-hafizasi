    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst gorevListesi = items.map((item, i) => {\n  const g = item.json;\n  const deadlineText = g.deadline !== 'Belirsiz' ? `📅 ${g.deadline}` : '📅 Deadline yok';\n  const oncelikEmoji = g.oncelik === 'Yüksek' ? '🔴' : g.oncelik === 'Orta' ? '🟡' : '🟢';\n  return `${i+1}. ${oncelikEmoji} *${g.gorev}*\\n   👤 ${g.kisi} | ${deadlineText}`;\n}).join('\\n\\n');\n\nconst transkript = items[0]?.json?.transkript || '';\nconst transkriptKisa = transkript.length > 200 ? transkript.substring(0, 200) + '...' : transkript;\n\nreturn [{\n  json: {\n    mesaj: `🎙️ *Sesli Not İşlendi!*\\n\\n📝 *Transkript:*\\n_${transkriptKisa}_\\n\\n✅ *Tespit Edilen Görevler (${items.length}):*\\n\\n${gorevListesi}\\n\\n_Görevler Sheets ve Takvime kaydedildi._`\n  }\n}];"
      },
